# Managed by install.sh - do not edit by hand, re-run install.sh instead.
# __USER__ is substituted by install.sh with the account the agent runs as.
#
# Narrow, explicit command list only. Never grant NOPASSWD:ALL here - the
# pairing token would then be equivalent to a root shell on this Pi.
__USER__ ALL=(root) NOPASSWD: /usr/bin/systemctl start *, /usr/bin/systemctl stop *, /usr/bin/systemctl restart *, /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/journalctl *
